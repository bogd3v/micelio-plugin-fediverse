# Names of the variables this project reads, with a safe example value. Copy to `.env` (never committed).
# Document each variable here and in README.md ("Configuration") when it is added.
# The plugin is read by a Strapi host; these are the host's variables. The suites set their own
# (test/strapi.ts and the files of test/app/config).

# Master switch, read by the host's config/plugins.ts (`enabled: env.bool('FEDIVERSE_ENABLED', false)`).
# Off: no routes and no content types.
FEDIVERSE_ENABLED=false

# Path of the actor URI (`/fediverse/user/<identifier>`). Required while FEDIVERSE_ENABLED=true.
# Never change it once followers exist: remote servers key the account and its followers by that URI.
FEDIVERSE_ACTOR_IDENTIFIER=blog

# Host of the handle (`@blog@example.com`) when it is not the host of URL. Unset: the host of URL.
# A bare host, no scheme or path; needs URL. Also listed in the actor's `attributionDomains`.
# FEDIVERSE_HANDLE_HOST=example.com

# Strapi's public origin. Fan-out runs outside any request and builds every activity id from it,
# so it must be the real public origin (https://cms.example.com), not localhost.
URL=http://localhost:1337

# Human-facing origin of the articles, in the `url` of every federated object and in the actor's
# `attributionDomains`. Required in production; otherwise http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Article path template on the frontend. Default: /blog/{slug}
# FRONTEND_ARTICLE_PATH=/blog/{slug}

# Locale the frontend serves without a URL prefix; other locales get /<locale> in their links. Default: en
# FRONTEND_DEFAULT_LOCALE=en

# Strapi's own, read by the plugin: the actor's private key is stored encrypted with it, and queued
# deliveries carry the key encrypted with it. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=replace-with-a-long-random-string
